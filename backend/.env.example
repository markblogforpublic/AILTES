# LLM API Keys (fill in your own keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Model Selection
# Provider: "openai" | "anthropic" | "local"
LLM_PROVIDER=anthropic
LLM_MODEL=deepseek-v4-flash

# Anthropic-compatible API base URL (leave empty for official API)
ANTHROPIC_BASE_URL=

# MongoDB (optional)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=aiscoring

# GPU acceleration backend: "cuda" | "vulkan" | "cpu"
GPU_BACKEND=cpu

# Server
HOST=0.0.0.0
PORT=8000

# CORS origins (comma-separated, use "*" for any)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ASR (Automatic Speech Recognition)
# Provider: "whisper" | "qwen_asr" | "online_api"
ASR_PROVIDER=whisper
# Whisper model: tiny / base / small / medium / large
ASR_MODEL=small
# Qwen3-ASR paths (only used when ASR_PROVIDER=qwen_asr):
QWEN_ASR_MODEL_PATH=
QWEN_ASR_MMPROJ_PATH=
# Online ASR API (only used when ASR_PROVIDER=online_api):
ONLINE_ASR_URL=
ONLINE_ASR_KEY=
ONLINE_ASR_MODEL=whisper-1

# GPU device selection (0 = first GPU)
CUDA_DEVICE=0

# Feature toggles
VOICE_DISABLED=false
